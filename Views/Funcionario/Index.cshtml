@using HighFlightAcademy.Models.Funcionario;
@model FuncionariosModel
<div>
    <h1>Funcionários</h1>
    <a type="button" class="btn btn-success" asp-controller="Funcionario" asp-action="Create">Adicionar</a>    
    <a class="btn btn btn-secondary" asp-area="" asp-controller="Home" asp-action="Index">Voltar</a>
    <table class="table table-hover table-light">
        <thead>
            <tr>                
                <th scope="col">Nome</th>
                <th scope="col">Sexo</th>
                <th scope="col">Dt. Nascimento</th>
                <th scope="col">CPF</th>
                <th scope="col">Cargo</th>
                <th scope="col">Telefone</th>
                <th scope="col">E-mail</th>
                <th scope="col">Situação</th>
                <th scope="col">Dt. Cadastro</th>
                <th scope="col">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var funcionario in Model.Funcionarios)
            {
                <tr>                    
                    <td>@funcionario.Nome</td>
                    <td>@funcionario.Sexo</td>
                    <td>@funcionario.DataNascimento</td>
                    <td>@funcionario.Cpf</td>
                    <td>@funcionario.ID_Cargo</td>
                    <td>@funcionario.Telefone</td>
                    <td>@funcionario.Email</td>
                    <td>
                        @if (funcionario.SituacaoRegistro == 1)
                        {
                            <span class="badge bg-success">Ativo</span>
                        }
                        else
                        {
                            <span class="badge bg-warning">Excluído</span>
                        }
                    </td>
                    <td>@funcionario.DataCadastro.ToString("dd/MM/yyyy")</td>
                    <td>
                        <a type="button" class="btn btn-primary btn-sm" asp-controller="Funcionario" asp-action="Editar" asp-route-id="@funcionario.ID_Funcionario">Editar</a>
                        <a type="button" class="btn btn-danger btn-sm" asp-controller="Funcionario" asp-action="Delete" asp-route-id="@funcionario.ID_Funcionario" onclick="return confirm('Tem certeza que deseja excluir esta Aeronave?')">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
